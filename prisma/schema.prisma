model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime @default(now())
  tasks       Task[]
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  isCompleted Boolean   @default(false)
  deadline    DateTime?
  createdAt   DateTime  @default(now())
  projectId   Int
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}